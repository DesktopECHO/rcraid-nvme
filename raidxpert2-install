#!/bin/bash
#
# raidxpert2-install — Build and install a patched AMD RAIDXpert2 DKMS package.
# Detects RPM (Fedora/RHEL) or DEB (Debian/Ubuntu) and produces the right package.
# Usage: ./raidxpert2-install [--blob=v1|v2]
#
set -euo pipefail

# ── Constants ────────────────────────────────────────────────────
DKMS_NAME="rcraid"
DKMS_VER="9.3.3"
PKG_NAME="rcraid-nvme"
PKG_VERSION="1"
PKG_RELEASE="1"
UPSTREAM_RPM_NAME="raidxpert2-9.3.3_00302-1.x86_64.rpm"

# ── Blob version selection ──────────────────────────────────────
# Both blobs get the same APU patches (see step 3); this only picks which
# one is actually linked into the built module. Default v2 (modern
# toolchain, full Spectre/CET hardening). Override with --blob=v1 or
# RCBLOB_VERSION=v1.
BLOB_VERSION="${RCBLOB_VERSION:-v2}"
for arg in "$@"; do
    case "$arg" in
        --blob=v1|--blob=v2) BLOB_VERSION="${arg#--blob=}" ;;
        --blob=*) echo "ERROR: --blob must be v1 or v2" >&2; exit 1 ;;
    esac
done
case "$BLOB_VERSION" in
    v1) BLOB_FILE="rcblob.x86_64" ;;
    v2) BLOB_FILE="rcblob_v2.x86_64" ;;
    *)  echo "ERROR: blob version must be v1 or v2 (got: $BLOB_VERSION)" >&2; exit 1 ;;
esac
echo "Blob selection: $BLOB_VERSION ($BLOB_FILE)"

# ── Detect distribution ──────────────────────────────────────────
if command -v apt-get >/dev/null 2>&1; then
    DISTRO="deb"
elif command -v dnf >/dev/null 2>&1; then
    DISTRO="rpm"
else
    echo "Neither apt-get nor dnf found — assuming RPM (live CD fallback)"
    DISTRO="rpm"
fi
echo "Detected: $DISTRO-based distribution"

# ── Escalate to root ─────────────────────────────────────────────
if [ "$EUID" -ne 0 ]; then
    echo "Re-running with sudo..."
    exec sudo "$0" "$@"
fi

# ── Resolve paths ────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
UPSTREAM_RPM="$SCRIPT_DIR/$UPSTREAM_RPM_NAME"
if [ ! -f "$UPSTREAM_RPM" ]; then
    echo "$UPSTREAM_RPM_NAME not found — downloading..."
    curl -fL -o "$UPSTREAM_RPM" \
        "https://github.com/DesktopECHO/rcraid-nvme/raw/refs/heads/main/$UPSTREAM_RPM_NAME"
    [ -f "$UPSTREAM_RPM" ] || { echo "ERROR: download failed"; exit 1; }
fi

KVER="$(uname -r)"
WORK="$(mktemp -d /tmp/rcraid-build.XXXX)"
trap 'rm -rf "$WORK"' EXIT
echo "Working in $WORK"

# ════════════════════════════════════════════════════════════════════
# 1.  Build dependencies
# ════════════════════════════════════════════════════════════════════
echo "Checking build dependencies..."
if [ "$DISTRO" = "deb" ]; then
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq
    apt-get install -y -qq --no-install-recommends \
        build-essential dwarves fakeroot dpkg-dev rpm2cpio cpio \
        dkms kmod python3 initramfs-tools "linux-headers-$KVER"
else
    NEED=()
    command -v rpmbuild  >/dev/null || NEED+=(rpm-build)
    command -v python3   >/dev/null || NEED+=(python3)
    command -v cpio      >/dev/null || NEED+=(cpio)
    rpm -q system-rpm-config   >/dev/null 2>&1 || NEED+=(system-rpm-config)
    (( ${#NEED[@]} )) && dnf install -y --setopt=install_weak_deps=False fuse-libs kernel-devel-$(uname -r) "${NEED[@]}"
fi

# ════════════════════════════════════════════════════════════════════
# 2.  Extract upstream RPM
# ════════════════════════════════════════════════════════════════════
echo "Extracting upstream RPM..."
ROOT="$WORK/root"
mkdir -p "$ROOT"
( cd "$ROOT" && rpm2cpio "$UPSTREAM_RPM" | cpio -idm --quiet )
rm -rf "$ROOT/usr/lib/.build-id"

SRC="$ROOT/usr/src/$DKMS_NAME-$DKMS_VER/src"
SDK="$ROOT/usr/src/$DKMS_NAME-$DKMS_VER"

# ════════════════════════════════════════════════════════════════════
# 3.  Patch binary blobs
# ════════════════════════════════════════════════════════════════════
# Both rcblob.x86_64 (v1, GCC 4.1.1, no hardening) and rcblob_v2.x86_64
# (v2, GCC 13.3, retpolines/CET/SLS) get patches 1 and 2 to unlock full
# RAID functionality on Ryzen APUs. v2 also gets patch 3 (stack canary
# neutralization): v2 was compiled with -fstack-protector-strong, which
# emits gs:[0x28] accesses that fault on kernels lacking
# CONFIG_STACKPROTECTOR_STRONG (e.g. custom builds on Linux >= 6.15 where
# fixed_percpu_data was removed). Patching unconditionally is safe because
# kernel modules have no meaningful stack-canary security boundary anyway.
# v1 (GCC 4.1.1) was built without stack protection and needs no patch.
# $BLOB_FILE (selected above) is the one actually linked into the module;
# the other is patched too but left unused on disk so --blob can be
# flipped later without re-running this whole extraction.
#
# Patch 1 — CPUID identity:
#   RC_HW_OS_GetLicenseLevel returns a CPUID-derived value that
#   DiscoverAdapter checks (top byte 0x2a) and GetProductNameAndFeatures
#   uses to pick product name + hardware flags via a hardcoded fast-path
#   for sub-type 0x03 ("RC-S…", mask 0x01ff — RAID 0/1/10). Patched to
#   unconditionally: mov eax, 0x2a030000 ; ret
#     v2 — file offset 0xce4 (.text+0xc50, right after the endbr64
#          prologue at 0xce0, which is preserved — v2 has CET landing pads)
#     v1 — file offset 0x1310 (.text+0x12d0 — no endbr64 to preserve;
#          GCC 4.1.1 predates CET, so the patch starts at the function entry)
#
# Patch 2 — Feature gate unlock:
#   RC_ScanBus initialises RC_CoreFeatureSet to 0xffff, then AND-reduces
#   it with each controller's per-controller mask. Changing that AND
#   (0x21) to CMP (0x39) preserves the instruction format and its
#   R_X86_64_PC32 relocation (so the module loader stays happy) but turns
#   the memory write into a read-only comparison that harmlessly sets
#   flags. RC_CoreFeatureSet stays at 0xffff: all RAID levels are available.
#     v2 — file offset 0x6017c (.text+0x600ec, inside RC_ScanBus)
#     v1 — file offset 0x5e959 (.text+0x5e919, inside the same function —
#          identical instruction encoding, different offset only because
#          v1 was built by a different compiler)
#
echo "Patching v1 and v2 blobs..."
python3 -c "
def patch1_v2(f):
    f.seek(0xce4)
    f.write(bytes([
        0xb8, 0x00, 0x00, 0x03, 0x2a,   # mov eax, 0x2a030000
        0xc3,                             # ret
        0x90, 0x90, 0x90, 0x90            # nop padding
    ]))
    f.seek(0xce0)
    got = f.read(10)
    expect = bytes([
        0xf3, 0x0f, 0x1e, 0xfa,          # endbr64 (preserved)
        0xb8, 0x00, 0x00, 0x03, 0x2a,    # mov eax, 0x2a030000
        0xc3                              # ret
    ])
    assert got == expect, f'v2 patch 1 verify failed: {got.hex()}'

def patch3_stack_canary(f):
    # v2 compiled with -fstack-protector-strong. GCC inserts:
    #   Prologue: 65 4W 8b MM 25 28 00 00 00  (MOV reg, gs:[0x28])
    #   Epilogue: 65 4W 2b MM 25 28 00 00 00  (SUB reg, gs:[0x28])
    # Each 9-byte sequence is replaced in-place with XOR reg,reg + NOPs:
    #   Prologue -> XOR r32,r32  (32-bit zero-extends; saved canary = 0)
    #   Epilogue -> XOR r64,r64  (diff = 0; stack check always passes)
    f.seek(0)
    data = bytearray(f.read())
    count = 0
    i = 0
    while i < len(data) - 8:
        if (data[i]   == 0x65 and
            data[i+1] in (0x48, 0x4c) and
            data[i+2] in (0x8b, 0x2b) and
            data[i+4] == 0x25 and
            data[i+5] == 0x28 and
            data[i+6] == 0x00 and
            data[i+7] == 0x00 and
            data[i+8] == 0x00):
            rex_r = (data[i+1] >> 2) & 1
            reg   = (data[i+3] >> 3) & 7
            xm    = 0xC0 | (reg << 3) | reg
            if data[i+2] == 0x8b:
                if rex_r:
                    data[i:i+9] = bytes([0x45, 0x31, xm, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90])
                else:
                    data[i:i+9] = bytes([0x31, xm, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90])
            else:
                if rex_r:
                    data[i:i+9] = bytes([0x4D, 0x31, xm, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90])
                else:
                    data[i:i+9] = bytes([0x48, 0x31, xm, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90])
            count += 1
            i += 9
        else:
            i += 1
    assert count > 0, f'patch3: no gs:[0x28] refs found (wrong blob?)'
    f.seek(0)
    f.write(bytes(data))
    return count

def patch1_v1(f):
    # No endbr64 prologue in v1 — overwrite starts at the function entry.
    f.seek(0x1310)
    got = f.read(9)
    expect = bytes([0x55, 0xbf, 0x01, 0x00, 0x00, 0x80, 0x48, 0x89, 0xe5])
    assert got == expect, f'v1 patch 1 pre-check failed: {got.hex()}'
    f.seek(0x1310)
    f.write(bytes([
        0xb8, 0x00, 0x00, 0x03, 0x2a,   # mov eax, 0x2a030000
        0xc3,                             # ret
        0x90, 0x90, 0x90, 0x90            # nop padding
    ]))
    f.seek(0x1310)
    got = f.read(10)
    expect = bytes([0xb8, 0x00, 0x00, 0x03, 0x2a, 0xc3, 0x90, 0x90, 0x90, 0x90])
    assert got == expect, f'v1 patch 1 verify failed: {got.hex()}'

def patch2(f, offset, label):
    # Change opcode byte only: 0x21 (AND r/m32,r32) → 0x39 (CMP r/m32,r32).
    # The ModRM, displacement, and relocation entry are all unchanged.
    f.seek(offset)
    old = f.read(1)
    assert old == bytes([0x21]), \
        f'{label} patch 2 pre-check failed (expected AND opcode 0x21): {old.hex()}'
    f.seek(offset)
    f.write(bytes([0x39]))   # CMP r/m32, r32
    f.seek(offset)
    got = f.read(1)
    assert got == bytes([0x39]), f'{label} patch 2 verify failed: {got.hex()}'

with open('$SRC/rcblob_v2.x86_64', 'r+b') as f:
    patch1_v2(f)
    patch2(f, 0x6017c, 'v2')
    n3 = patch3_stack_canary(f)
print(f'  v2 blob (rcblob_v2.x86_64): patches 1-3 applied and verified ({n3} gs:[0x28] refs neutralized)')

with open('$SRC/rcblob.x86_64', 'r+b') as f:
    patch1_v1(f)
    patch2(f, 0x5e959, 'v1')
print('  v1 blob (rcblob.x86_64): both patches applied and verified')
"

echo "Linking selected blob for build: $BLOB_VERSION ($BLOB_FILE)"
ln -sf "$BLOB_FILE" "$SRC/rcblob.x86_64.o"

# ════════════════════════════════════════════════════════════════════
# 4.  Patch C source and Makefile
# ════════════════════════════════════════════════════════════════════
echo "Patching source files..."

# Cleanup logging
sed -i 's/matched supported adapter - vendor = 0x%x device 0x%x/matched supported adapter, Vendor:%04x, Device:%04x/' \
    "$SRC/rc_init.c"

# register_sysctl → register_sysctl_sz (removed in 6.11+)
sed -i 's/register_sysctl("rcraid", rcraid_table)/register_sysctl_sz("rcraid", rcraid_table, ARRAY_SIZE(rcraid_table) - 1)/' \
    "$SRC/rc_init.c"

# NVMe VID/DID fallback for APU platforms
grep -q 'orig_device_id = AMD_NVME_DID' "$SRC/rc_init.c" ||
sed -i '/RC_Unmap_VidDid.*orig_vendor_id.*orig_device_id/a\
\
    if (hw->orig_vendor_id == 0 \&\& hw->orig_device_id == 0 \&\&\
        id->vendor == 0x1022 \&\& id->device == AMD_NVME_DID) {\
        hw->orig_vendor_id = 0x1022;\
        hw->orig_device_id = AMD_NVME_DID;\
        rc_printk(RC_WARN, RC_DRIVER_NAME ": %s AMD NVMe "\
                  "on bus %d slot %d, Vendor:%04x Device:%04x\\n",\
                  __FUNCTION__, hw->pci_bus, hw->pci_slot,\
                  hw->orig_vendor_id, hw->orig_device_id);\
    }' "$SRC/rc_init.c"

# EXTRA_CFLAGS → ccflags-y
sed -i 's/EXTRA_CFLAGS/ccflags-y/g' "$SRC/Makefile"

# mk_certs: fix typo + add Fedora/Debian sign-file paths
sed -i 's/-outform DEV/-outform DER/g' "$SDK/mk_certs"
sed -i 's|if \[ -f "/usr/src/linux-headers-\$KVERS/scripts/sign-file" \]; then|if [ -f "/usr/src/linux-headers-$KVERS/scripts/sign-file" ]; then\n\t\tSIGN_TOOL=/usr/src/linux-headers/$KVERS/scripts/sign-file\n\t    elif [ -f "/usr/src/kernels/$KVERS/scripts/sign-file" ]; then|g' "$SDK/mk_certs"

# rc_thunk_stubs.S — fallback Spectre mitigation thunks compiled in only
# when the kernel lacks CONFIG_RETPOLINE/CONFIG_RETHUNK (pre_build.sh adds
# rc_thunk_stubs.o to rcraid-objs only in that case). v2 was built with
# -mindirect-branch=thunk-extern and -mfunction-return=thunk-extern; these
# stubs provide direct jmp/ret so the module links on kernels that opt out
# of Spectre mitigations. v1 (GCC 4.1.1) has no such flags and needs none.
cat > "$SRC/rc_thunk_stubs.S" << 'THUNKEOF'
/* rc_thunk_stubs.S — fallback retpoline thunks for CONFIG_RETPOLINE=n kernels.
 * pre_build.sh adds rc_thunk_stubs.o to rcraid-objs only when the running
 * kernel does not export these symbols. On standard Fedora/Debian kernels
 * CONFIG_RETPOLINE=y and this file is not compiled in. */
#include <linux/linkage.h>

SYM_FUNC_START(__x86_return_thunk)
	ret
	int3
SYM_FUNC_END(__x86_return_thunk)

SYM_FUNC_START(__x86_indirect_thunk_rax)
	jmp *%rax
SYM_FUNC_END(__x86_indirect_thunk_rax)

SYM_FUNC_START(__x86_indirect_thunk_rcx)
	jmp *%rcx
SYM_FUNC_END(__x86_indirect_thunk_rcx)

SYM_FUNC_START(__x86_indirect_thunk_rdx)
	jmp *%rdx
SYM_FUNC_END(__x86_indirect_thunk_rdx)

SYM_FUNC_START(__x86_indirect_thunk_r8)
	jmp *%r8
SYM_FUNC_END(__x86_indirect_thunk_r8)

SYM_FUNC_START(__x86_indirect_thunk_r9)
	jmp *%r9
SYM_FUNC_END(__x86_indirect_thunk_r9)

SYM_FUNC_START(__x86_indirect_thunk_r10)
	jmp *%r10
SYM_FUNC_END(__x86_indirect_thunk_r10)

SYM_FUNC_START(__x86_indirect_thunk_r11)
	jmp *%r11
SYM_FUNC_END(__x86_indirect_thunk_r11)

SYM_FUNC_START(__x86_indirect_thunk_r12)
	jmp *%r12
SYM_FUNC_END(__x86_indirect_thunk_r12)
THUNKEOF

# Makefile: replace blob-selection case with the selected blob's symlink, remove redhat-release guards
python3 - "$SRC/Makefile" "$BLOB_FILE" << 'PYEOF'
import re, sys

with open(sys.argv[1]) as f:
    mk = f.read()

mk = re.sub(
    r'\t@case "\$\(KVERS\)".*?esac',
    f'\t@ln -sf {sys.argv[2]} rcblob.x86_64.o',
    mk, flags=re.DOTALL
)
mk = re.sub(
    r'\t@if \[ ! -e /etc/redhat-release \]; then\s*\\?\n(.*?)\t fi',
    lambda m: m.group(1).rstrip(),
    mk, flags=re.DOTALL
)

with open(sys.argv[1], 'w') as f:
    f.write(mk)
PYEOF

# ════════════════════════════════════════════════════════════════════
# 5.  Write DKMS metadata
# ════════════════════════════════════════════════════════════════════
echo "Writing DKMS files..."

# MAKE wraps the real make in a subshell with a trap so that the
# pahole symlink (set up by pre_build.sh) is always restored, even
# when the build fails.
cat > "$SDK/dkms.conf" << 'DKMSEOF'
PACKAGE_NAME="rcraid"
PACKAGE_VERSION="9.3.3"
BUILT_MODULE_NAME[0]="rcraid"
BUILT_MODULE_LOCATION[0]="src"
DEST_MODULE_LOCATION[0]="/kernel/drivers/scsi"
AUTOINSTALL="yes"
SIGN="no"
PRE_BUILD="pre_build.sh $kernelver"
MAKE[0]="bash -c 'restore_pahole() { if [ -f /usr/bin/pahole.real ]; then mv /usr/bin/pahole.real /usr/bin/pahole; elif [ -L /usr/bin/pahole ]; then rm -f /usr/bin/pahole; fi; }; trap restore_pahole EXIT; make -C ${kernel_source_dir} M=${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build/src modules'"
DKMSEOF

cat > "$SDK/pre_build.sh" << 'PREBUILD'
#!/bin/bash
set -euo pipefail
KVER="${1:?pre_build.sh requires a kernel version argument}"
DIR="$(dirname "$0")/src"
cd "$DIR"

KMAJ="${KVER%%.*}"
KMIN="${KVER#*.}"; KMIN="${KMIN%%.*}"
kver_ge() { [ "$KMAJ" -gt "$1" ] || { [ "$KMAJ" -eq "$1" ] && [ "$KMIN" -ge "$2" ]; }; }
echo "pre_build.sh: kernel $KVER (major=$KMAJ minor=$KMIN)"

# Clean previous build
for d in "/usr/src/linux-headers-$KVER" "/usr/src/kernels/$KVER" "/lib/modules/$KVER/build"; do
    [ -d "$d" ] && { make -C "$d" M="$DIR" clean 2>/dev/null || true; break; }
done

ln -sf rcblob_v2.x86_64 rcblob.x86_64.o

# pahole workaround (kernel ≤ 6.12) — swap with /bin/true before build;
# the MAKE[0] trap in dkms.conf restores it afterward.
if ! kver_ge 6 13; then
    PAHOLE="$(command -v pahole 2>/dev/null || true)"
    if [ -n "$PAHOLE" ] && [ ! -L "$PAHOLE" ]; then
        echo "  pahole workaround: $PAHOLE → /bin/true (kernel ≤ 6.12)"
        mv "$PAHOLE" "${PAHOLE}.real"
        ln -sf /bin/true "$PAHOLE"
    fi
fi

# Timer API (kernel ≥ 6.13)
if kver_ge 6 13; then
    sed -i 's/\bfrom_timer\b/timer_container_of/g' rc_init.c rc_msg.c
    sed -i 's/\bdel_timer_sync\b/timer_delete_sync/g' rc_msg.c
else
    sed -i 's/\btimer_container_of\b/from_timer/g' rc_init.c rc_msg.c
    sed -i 's/\btimer_delete_sync\b/del_timer_sync/g' rc_msg.c
fi

# bios_param signature (kernel ≥ 6.18)
if kver_ge 6 18; then
    sed -i 's/struct block_device \*bdev/struct gendisk *disk/g' rc_init.c
else
    sed -i 's/struct gendisk \*disk/struct block_device *bdev/g' rc_init.c
fi

# Retpoline thunk stubs: include rc_thunk_stubs.o only when the kernel
# doesn't export __x86_return_thunk (CONFIG_RETPOLINE=n CONFIG_RETHUNK=n).
# Check Module.symvers first; /proc/kallsyms as fallback.
HAVE_THUNKS=false
SYMVERS="/lib/modules/$KVER/build/Module.symvers"
if grep -q "__x86_return_thunk" "$SYMVERS" 2>/dev/null; then
    HAVE_THUNKS=true
elif grep -q "__x86_return_thunk" /proc/kallsyms 2>/dev/null; then
    HAVE_THUNKS=true
fi
if $HAVE_THUNKS; then
    sed -i 's/ rc_thunk_stubs\.o//g' Makefile
    echo "  Retpoline thunks provided by kernel — stubs not compiled"
else
    grep -q 'rc_thunk_stubs\.o' Makefile || \
        sed -i 's/\(vers\.o\)/\1 rc_thunk_stubs.o/' Makefile
    echo "  Retpoline thunks absent from kernel — adding rc_thunk_stubs.o"
fi

echo "pre_build.sh: done"
PREBUILD
# pre_build.sh is a quoted heredoc (its $KVER/$1/etc. must stay literal
# until it runs later), so the blob symlink target is substituted here.
sed -i "s/rcblob_v2\.x86_64/$BLOB_FILE/" "$SDK/pre_build.sh"
chmod +x "$SDK/pre_build.sh"

# ════════════════════════════════════════════════════════════════════
# 6.  Write shared DKMS lifecycle script
# ════════════════════════════════════════════════════════════════════
cat > "$SDK/rcraid-dkms.sh" << 'LIFECYCLE'
#!/bin/bash
# rcraid-dkms.sh — shared DKMS lifecycle handler
# Called by package postinst / prerm scripts.
# Usage: rcraid-dkms.sh  install | remove
set -e

ACTION="${1:?Usage: rcraid-dkms.sh install|remove}"
DKMS_NAME="rcraid"
DKMS_VER="9.3.3"
KVER="$(uname -r)"

# Detect initramfs tool
if command -v dracut >/dev/null 2>&1; then
    regen_initramfs() { dracut --force "/boot/initramfs-${KVER}.img" "$KVER" 2>&1 || true; }
elif command -v update-initramfs >/dev/null 2>&1; then
    regen_initramfs() { update-initramfs -u -k "$KVER" 2>&1 || true; }
else
    regen_initramfs() { echo "  WARNING: no initramfs tool found"; }
fi

# Detect header directory
find_headers() {
    for d in "/usr/src/linux-headers-$KVER" "/usr/src/kernels/$KVER" "/lib/modules/$KVER/build"; do
        [ -d "$d" ] && return 0
    done
    return 1
}

case "$ACTION" in
install)
    echo "rcraid: configuring DKMS module for kernel $KVER ..."

    if ! find_headers; then
        echo "  WARNING: kernel headers for $KVER not found."
        echo "  Install them, then run:  dkms install $DKMS_NAME/$DKMS_VER -k $KVER"
    fi

    # Clear stale DKMS state
    if dkms status "$DKMS_NAME/$DKMS_VER" 2>/dev/null | grep -q "$DKMS_NAME"; then
        dkms remove "$DKMS_NAME/$DKMS_VER" --all 2>/dev/null || true
    fi

    echo "  dkms add $DKMS_NAME/$DKMS_VER"
    dkms add "$DKMS_NAME/$DKMS_VER" 2>&1

    echo "  dkms build $DKMS_NAME/$DKMS_VER -k $KVER"
    if ! dkms build "$DKMS_NAME/$DKMS_VER" -k "$KVER" 2>&1; then
        echo "ERROR: DKMS build failed — see /var/lib/dkms/$DKMS_NAME/$DKMS_VER/build/make.log"
        exit 1
    fi

    echo "  dkms install $DKMS_NAME/$DKMS_VER -k $KVER"
    if ! dkms install "$DKMS_NAME/$DKMS_VER" -k "$KVER" 2>&1; then
        MOD="/var/lib/dkms/$DKMS_NAME/$DKMS_VER/build/src/rcraid.ko"
        if [ -f "$MOD" ]; then
            echo "  WARNING: dkms install failed — copying module manually"
            mkdir -p "/lib/modules/$KVER/kernel/drivers/scsi"
            cp "$MOD" "/lib/modules/$KVER/kernel/drivers/scsi/"
            depmod -a "$KVER" 2>/dev/null || true
        else
            echo "ERROR: module not found after build"
            exit 1
        fi
    fi

    echo "  Loading rcraid..."
    modprobe rcraid 2>/dev/null || true
    if lsmod | grep -q '^rcraid '; then
        echo "  rcraid loaded"
    else
        echo "  rcraid installed — will load on next boot"
    fi

    echo "  Regenerating initramfs..."
    regen_initramfs
    echo "rcraid: done"
    ;;

remove)
    echo "rcraid: removing DKMS module..."
    lsmod | grep -q '^rcraid ' && modprobe -r rcraid 2>/dev/null || true
    dkms remove "$DKMS_NAME/$DKMS_VER" --all 2>/dev/null || true
    echo "  Regenerating initramfs..."
    regen_initramfs
    echo "rcraid: removed"
    ;;

*)
    echo "Usage: rcraid-dkms.sh install|remove" >&2
    exit 1
    ;;
esac
LIFECYCLE
chmod +x "$SDK/rcraid-dkms.sh"

# ════════════════════════════════════════════════════════════════════
# 7.  Initramfs configuration (distro-specific)
# ════════════════════════════════════════════════════════════════════
if [ "$DISTRO" = "rpm" ]; then
    mkdir -p "$ROOT/etc/dracut.conf.d"
    cat > "$ROOT/etc/dracut.conf.d/90-rcraid.conf" << 'EOF'
add_drivers+=" rcraid "
EOF

    mkdir -p "$ROOT/usr/lib/dracut/modules.d/90rcraid"
    cat > "$ROOT/usr/lib/dracut/modules.d/90rcraid/module-setup.sh" << 'EOF'
#!/bin/bash
check()         { return 0; }
depends()       { return 0; }
install()       { instmods rcraid; }
installkernel() { instmods rcraid; }
EOF
    chmod +x "$ROOT/usr/lib/dracut/modules.d/90rcraid/module-setup.sh"

elif [ "$DISTRO" = "deb" ]; then
    mkdir -p "$ROOT/etc/initramfs-tools/hooks"
    cat > "$ROOT/etc/initramfs-tools/hooks/rcraid" << 'EOF'
#!/bin/sh
PREREQ=""
prereqs() { echo "$PREREQ"; }
case $1 in prereqs) prereqs; exit 0;; esac
. /usr/share/initramfs-tools/hook-functions
manual_add_modules rcraid
EOF
    chmod +x "$ROOT/etc/initramfs-tools/hooks/rcraid"

    mkdir -p "$ROOT/etc/modules-load.d"
    echo "rcraid" > "$ROOT/etc/modules-load.d/rcraid.conf"

    # Remove Fedora-specific dracut files from the upstream RPM
    rm -rf "$ROOT/etc/dracut.conf.d" "$ROOT/usr/lib/dracut"
